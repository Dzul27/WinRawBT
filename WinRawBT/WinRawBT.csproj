<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WinRawBT</AssemblyName>
    <RootNamespace>WinRawBT</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>WinRawBT Team</Authors>
    <Description>Windows Bluetooth ESC/POS Print Bridge Service</Description>
    
    <!-- Enable cross-platform Windows targeting -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    
    <!-- Single-File Self-Contained Build Settings (TASK-17) -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bluetooth Library (TASK-01) -->
    <PackageReference Include="InTheHand.Net.Bluetooth" Version="4.1.0" />
    
    <!-- JSON Serialization (TASK-01) -->
    <PackageReference Include="System.Text.Json" Version="8.0.0" />
  </ItemGroup>

</Project>
